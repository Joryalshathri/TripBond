# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_KEY: Deprecated, kept for backward compatibility
# Will be used as SERVICE_ROLE_KEY if SUPABASE_SERVICE_ROLE_KEY is not set
SUPABASE_KEY=your-service-role-key-here

# SUPABASE_ANON_KEY: Public anon key (required) - Used for RLS-enabled operations
# Get this from: Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: Service role key (optional) - Bypasses RLS
# Only needed for admin operations. If not set, SUPABASE_KEY will be used.
# Get this from: Supabase Dashboard > Settings > API > Project API keys > service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Google Maps / Places API
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: "Places API" (and optionally "Maps JavaScript API") in your GCP project
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
